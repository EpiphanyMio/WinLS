<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" />
    <application android:allowBackup="false" android:label="定位模拟器配套应用"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- adb shell has DUMP; regular third-party apps cannot send location commands. -->
        <receiver android:name=".LocationCommandReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.windowslocationsimulator.mock.LOCATION_COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
